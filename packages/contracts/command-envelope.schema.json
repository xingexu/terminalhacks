{
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "event.correct",
        "recollection.add",
        "profile.set",
        "anchor.add",
        "artifact.approve",
        "event.media.link",
        "undo"
      ]
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    },
    "previewToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "requestId",
    "expectedRevision",
    "type",
    "targetId",
    "payload",
    "previewToken"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Strict internal command envelope; server additionally checks auth, referential integrity, finite numbers, preview scope and timestamps.",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "event.correct"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "patch": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "placeLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "startAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "story": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [],
                "additionalProperties": false,
                "minProperties": 1
              }
            },
            "required": [
              "patch"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "recollection.add"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "anchorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "audioMediaId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "profile.set"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "preset": {
                "enum": [
                  "natural",
                  "nostalgic",
                  "documentary",
                  "vivid"
                ]
              }
            },
            "required": [
              "preset"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "anchor.add"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "worldId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "uniqueItems": true
              }
            },
            "required": [
              "worldId",
              "position",
              "sourceIds"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact.approve"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "dependencyHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "artifactId",
              "dependencyHash"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "event.media.link"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "mediaId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "relation": {
                "enum": [
                  "depicts",
                  "context",
                  "reference"
                ]
              }
            },
            "required": [
              "mediaId",
              "relation"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "undo"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "revisionToUndo": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "revisionToUndo"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
