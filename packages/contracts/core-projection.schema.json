{
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "visualProfile": {
      "enum": [
        "natural",
        "nostalgic",
        "documentary",
        "vivid"
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mime": {
            "enum": [
              "image/jpeg",
              "video/mp4"
            ]
          },
          "capturedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "provenance": {
            "const": "original"
          }
        },
        "required": [
          "id",
          "mime",
          "capturedAt",
          "caption",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "startAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "placeLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "startAt",
          "placeLabel",
          "version",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "worldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "eventId",
          "worldId",
          "position",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "recollections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "contributorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "provenance": {
            "const": "recollected"
          }
        },
        "required": [
          "id",
          "eventId",
          "contributorId",
          "text",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "world",
              "film",
              "walkthrough"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "ready",
              "failed",
              "stale",
              "cancelled"
            ]
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "inputHash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "projectId",
    "revision",
    "visualProfile",
    "media",
    "events",
    "anchors",
    "recollections",
    "jobs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Minimal shared P0 fixture projection, not full persistence or snapshot API response; extend through lead-approved contract change."
}
