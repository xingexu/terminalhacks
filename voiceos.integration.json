{
  "schemaVersion": 1,
  "id": "com.everwhere.memories",
  "version": "0.4.0",
  "name": "Everwhere",
  "summary": "Find memories, revisit places, and review your stories by voice.",
  "publisher": {
    "id": "everwhere",
    "name": "Everwhere"
  },
  "repository": "https://github.com/xingexu/terminalhacks",
  "runtime": {
    "kind": "local-mcp",
    "command": "node",
    "args": [
      "apps/mcp/index.mjs"
    ]
  },
  "permissions": [
    {
      "kind": "network",
      "domains": [
        "127.0.0.1",
        "localhost",
        "[::1]"
      ]
    }
  ],
  "auth": {
    "kind": "apiKey",
    "fields": [
      {
        "key": "EVERWHERE_PAIRING_TOKEN",
        "label": "Pairing token from Everwhere → VoiceOS",
        "secret": true,
        "required": true
      }
    ]
  },
  "preferences": [
    {
      "name": "EVERWHERE_API",
      "title": "API origin",
      "type": "text",
      "default": "http://127.0.0.1:4173",
      "description": "The address of your running Everwhere server."
    },
    {
      "name": "EVERWHERE_PROJECT",
      "title": "Project ID",
      "type": "text",
      "required": true,
      "description": "Copy the project ID from Everwhere → VoiceOS."
    }
  ],
  "tools": [
    {
      "name": "get_context",
      "description": "Read the active project, event, live Street View movement options and reviewed route stops/anchors. navigation.instructions explains how to complete a multi-step walk-around request using repeated move_player calls and named navigate_anchor destinations. Current link availability is short-lived; refresh between steps.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "retrieve_media",
      "description": "Find relevant authorized source media; no mutation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "select_event",
      "description": "Resolve event query or show candidates; selection only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "navigate_anchor",
      "description": "Select a reviewed destination in the active memory by anchorId OR by a user-supplied place description in query. Query matching uses authored stop titles/descriptions with explicit lexical evidence, not image vision. Ambiguous/no-match descriptions return candidates without changing the selection. Use this after linking a camera photo and recording its supplied description; the photo does not generate Google imagery. Selection is not confirmed arrival: the browser must load the destination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "anchorId"
            ]
          },
          {
            "required": [
              "query"
            ]
          }
        ]
      }
    },
    {
      "name": "move_player",
      "description": "Move or turn in the currently open Everwhere scene. Call directly for forward/backward, left/right path, turn_left/turn_right, or stop; no context lookup is required. Omit worldId to target the active browser viewer. Street View follows available linked panoramas; GLB scenes use continuous walking. A new command replaces the prior one. The MCP adapter briefly waits for the matching browser receipt. Report completed, blocked or stopped only when the returned receipt confirms it; a queued response remains unconfirmed. Describe the actual result to the user, not a plan. get_context movementReceipt also reports the observed browser outcome. For a named destination or restaurant interior, look up its reviewed anchor in get_context and use navigate_anchor; do not invent an enter direction or unavailable coverage. The 90-degree limit applies per turn only; repeated separate turns and moves are supported. For walk-around requests, use get_context navigation instructions and available directions, perform a short sequence one acknowledged step at a time, and reassess. Do not describe the experience as a fixed photograph or refuse a route merely because a single turn is bounded.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "worldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "direction": {
            "enum": [
              "forward",
              "backward",
              "left",
              "right",
              "turn_left",
              "turn_right",
              "stop"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 5
          },
          "degrees": {
            "type": "number",
            "minimum": 1,
            "maximum": 90
          }
        },
        "required": [
          "direction"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "switch_view",
      "description": "Switch view retaining active event.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "view": {
            "enum": [
              "universe",
              "remember",
              "explore",
              "watch",
              "create",
              "archive"
            ]
          }
        },
        "required": [
          "view"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "set_lens",
      "description": "Switch provenance lens; never bypass approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "original",
              "reconstructed",
              "cinematic",
              "dream"
            ]
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_gap_question",
      "description": "Ask a nonleading question for a selected event.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "eventId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "preview_recollection",
      "description": "Propose participant account and optional anchor; no write.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "anchorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "eventId",
          "text",
          "expectedRevision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "preview_correction",
      "description": "Preview an event patch and dependent changes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "patch": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "placeLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "startAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "story": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "gps": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    ],
                    "additionalItems": false
                  }
                ]
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "eventId",
          "patch",
          "expectedRevision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "confirm_change",
      "description": "Commit exact preview for same actor/project/revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "previewToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "previewToken",
          "requestId",
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Confirm the reviewed change?",
          "children": [
            {
              "type": "text",
              "text": "Apply the Everwhere preview you just reviewed. Expired or changed previews must be reviewed again."
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Confirm change",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "preview_style",
      "description": "Preview global creative preset; does not overwrite originals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "preset": {
            "enum": [
              "natural",
              "nostalgic",
              "documentary",
              "vivid"
            ]
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "preset",
          "expectedRevision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "preview_undo",
      "description": "Preview undo latest eligible change as new revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "expectedRevision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "preview_compile",
      "description": "Estimate cost/inputs for generation; no charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "formats": {
            "type": "array",
            "items": {
              "enum": [
                "film",
                "photo_album",
                "video_album",
                "journal",
                "world",
                "walkthrough"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "formats",
          "expectedRevision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_job",
      "description": "Inspect actual job status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_capture_inbox",
      "description": "List pending authorized capture observations in paired project. Read only.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "preview_capture_link",
      "description": "Preview linking one pending observation to an existing event; use confirm_change for commit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "observationId",
          "eventId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_scene_evidence",
      "description": "Read linked photo timestamps, coordinates, reviewed recollections, place context, suggestions and uncertainties for a scene. No external request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "research_place",
      "description": "With explicit user consent, query Wikipedia for the memory place using approximate coordinates or a place query. Sends no photos or recollection text. Returns cited background, not evidence of the historical event.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "consent": {
            "const": true
          }
        },
        "required": [
          "expectedRevision",
          "consent"
        ],
        "additionalProperties": false
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Research this place on Wikipedia?",
          "children": [
            {
              "type": "text",
              "text": "Send the memory place name or approximate coordinates to Wikipedia. Photos and conversation stay private. Results are background context, not proof of your memory."
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Confirm change",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "preview_memory_world",
      "description": "Preview an imagined procedural world from approved original photos, timestamps, place and recollections. Read get_scene_evidence first, explain uncertainties and selected environment/season; ask user to confirm the returned preview with confirm_change. Not a measured reconstruction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "environment": {
            "enum": [
              "mountain",
              "coast",
              "forest",
              "urban",
              "open"
            ]
          },
          "season": {
            "enum": [
              "green",
              "snow",
              "autumn"
            ]
          }
        },
        "required": [
          "expectedRevision",
          "environment",
          "season"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "camera_action",
      "description": "Open the computer camera preview in the visible Everwhere browser, capture one photo after the user has reviewed the preview, or close the camera. Use action open before capture; browser camera permission and source consent remain required. Captured frames stay in the review inbox until preview_capture_link and confirm_change. A queued response is not proof of camera access or capture; inspect get_context cameraReceipt. The photo supplies a memory source, not a generated Google panorama. Never infer the displayed picture’s original date or location from its new camera capture.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "open",
              "capture",
              "close"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  ]
}
